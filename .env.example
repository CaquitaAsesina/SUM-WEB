# ============================================
# Sistema de Suministros - Variables de entorno
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================

# Server
PORT=3000
NODE_ENV=development

# Database - Aiven Cloud MySQL
DB_HOST=your-service-host.aivencloud.com
DB_PORT=26056
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password
DB_NAME=suministros
DB_SSL=true

# JWT (usa una cadena larga y aleatoria; ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=generate_a_random_secret_here
JWT_EXPIRES_IN=8h

# --- OPCIONAL: Solo para primera instalación (npm run db:init) ---
# Si la BD ya tiene usuarios, estas variables no son necesarias.
# ADMIN_USERNAME=admin_account_id
# ADMIN_PASSWORD=choose_a_strong_password
# ADMIN_NAME=Administrador General
# VIEWER_USERNAME=VISITANTE
# VIEWER_PASSWORD=choose_a_strong_password
# VIEWER_NAME=Usuario de Solo Lectura
